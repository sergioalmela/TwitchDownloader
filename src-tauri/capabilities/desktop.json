{
  "identifier": "desktop-capability",
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "windows": ["main", "preferences"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "dialog:allow-open",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://gql.twitch.tv/gql"
        },
        {
          "url": "https://usher.ttvnw.net/*"
        }
      ]
    }
  ]
}
