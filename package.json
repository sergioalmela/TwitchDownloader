  "license": "GPLv3",
  "description": "Free tool to download Twitch content with GUI",
  "author": "Sergio Almela",
  "keywords": [
    "twitch",
    "downloader",
    "gui",
    "app",
    "video",
    "audio",
    "stream",
    "linux",
    "windows",
    "macos"
  ],
  "private": true,
